# ── Claude API ──────────────────────────────────────────────
# 從 https://console.anthropic.com 取得
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# 生成模型（預設 claude-opus-4-8，可改 claude-sonnet-5 省成本）
CLAUDE_MODEL=claude-opus-4-8

# 是否開啟 web search 抓最新事實（GEO/AIO 建議開；1=開 0=關）
ENABLE_WEB_SEARCH=1

# ── WordPress ───────────────────────────────────────────────
# 你的網站網址（結尾不要加斜線）
WP_BASE_URL=https://你的網站.com

# WordPress 使用者名稱
WP_USERNAME=your_wp_username

# 應用程式密碼：WP 後台 → 使用者 → 個人資料 → 最下方「應用程式密碼」建立
# 貼上時保留空格或去掉都可以，程式會自動處理
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# 發佈狀態：draft=草稿（建議）、publish=直接上架、pending=待審
WP_POST_STATUS=draft

# 文章語言（會傳給 AI，例：繁體中文 / English）
ARTICLE_LANGUAGE=繁體中文

# 參考既有文章的結構/風格：用這個關鍵字撈站上已發佈文章當範本（例：移民）
# 留空則參考最新的文章；REFERENCE_COUNT=0 可完全關閉此功能
REFERENCE_QUERY=移民
REFERENCE_COUNT=2

# 保底配圖：AI 找不到夠相關的圖時，仍用媒體庫最接近的一張（1=開 0=關）
IMAGE_FALLBACK=1

# ── 網頁版（app.py）─────────────────────────────────────────
# 員工使用網頁時要輸入的存取密碼，自己設一組（避免網址外流被亂用）
APP_PASSWORD=自己設一組通行碼
